# CouponBeee Environment Variables
# AI Studio automatically injects GEMINI_API_KEY and APP_URL at runtime.

# Application URL (used for canonical links, sitemaps, and redirects)
APP_URL="https://couponbeee.org"

# Server Port (default 3000)
PORT=3000

# Node Environment
NODE_ENV="development"

# PostgreSQL Database Connection URL (for production Prisma deployments)
DATABASE_URL="postgresql://couponbeee_user:secure_password@localhost:5432/couponbeee_db?schema=public"

# Optional Gemini AI API Key for editorial summarization
GEMINI_API_KEY=""

# Admin Session Secret
ADMIN_SESSION_SECRET="super-secure-production-random-secret-key-32-chars"
